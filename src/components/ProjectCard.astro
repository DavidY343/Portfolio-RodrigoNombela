---
const { title, thumbnail, link, images = [] } = Astro.props;
---

<div 
    class="group relative overflow-hidden bg-gray-50 border border-gray-100 cursor-pointer transition-all duration-500"
    data-title={title}
    data-images={JSON.stringify(images)}
    data-link={link}
>
    <!-- Imagen Principal -->
    <img 
        src={thumbnail} 
        alt={title} 
        referrerpolicy="no-referrer"
        class="aspect-[4/5] w-full object-cover transition-all duration-1000 group-hover:scale-105 group-hover:opacity-90"
    />
    
    <!-- Info Overlay Minimalista -->
    <div class="absolute inset-x-0 bottom-0 p-6 translate-y-full group-hover:translate-y-0 transition-transform duration-500 bg-white/90 backdrop-blur-sm border-t border-gray-100 flex flex-col items-center justify-center text-center">
        <h3 class="text-[10px] tracking-[0.2em] uppercase font-medium text-black mb-2">{title}</h3>
        <span class="text-[8px] tracking-[0.3em] uppercase text-gray-400">Ver proyecto →</span>
    </div>
</div>

