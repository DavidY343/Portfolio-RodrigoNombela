---
import { fetchBehanceProjects, groupProjects, CATEGORIES } from '../services/behance';
import ProjectCard from './ProjectCard.astro';

interface Props {
    projects?: any[];
}

const { projects: initialProjects } = Astro.props;
const projects = initialProjects || await fetchBehanceProjects();
const groupedProjects = groupProjects(projects);
const activeCategories = CATEGORIES.filter(c => groupedProjects[c.id].length > 0);
---

<section class="max-w-7xl mx-auto px-6 py-24">
    
    <!-- Secciones de Proyectos -->
    {projects.length > 0 ? (
        <div class="space-y-40">
            {activeCategories.map(cat => (
                <section id={`seccion-${cat.id}`} class="scroll-mt-32">
                    <div class="text-center mb-16">
                        <h2 class="text-[10px] tracking-[0.5em] uppercase text-gray-400 font-light mb-4">{cat.name}</h2>
                        <div class="h-px w-12 bg-gray-200 mx-auto"></div>
                    </div>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-12">
                        {groupedProjects[cat.id].map(project => (
                            <ProjectCard 
                                title={project.title} 
                                thumbnail={project.thumbnail} 
                                link={project.link} 
                                images={project.images}
                            />
                        ))}
                    </div>
                </section>
            ))}
        </div>
    ) : (
        <div class="col-span-full py-40 text-center border border-gray-100 bg-gray-50/50">
            <p class="text-[10px] tracking-widest uppercase text-gray-400">Cargando portafolio...</p>
        </div>
    )}
</section>

